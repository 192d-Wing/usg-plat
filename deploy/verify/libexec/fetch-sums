#!/bin/sh
# usg-plat-verify: cache SHA256SUMS and SHA256SUMS.sigstore.json per release.
#
# Usage: fetch-sums [TAG-or-VERSION ...]
#   Arguments are tags (v0.3.0) or package versions (0.3.0, 0.3.0-1). With no
#   arguments the apt candidate and installed versions of NAMES are used (apt
#   hosts; the dnf plugin passes the versions it is about to install).
# Fetches <REPO_BASE>/releases/<tag>/{SHA256SUMS,SHA256SUMS.sigstore.json}
# into /var/lib/usg-plat-verify/releases/<tag>/ and keeps the newest 20.
# Exit: 0 all fetched (or nothing to do); 1 a fetch failed; 2 configuration.
#
# The transport is not trusted: nothing here is believed until verify-pkg has
# verified the bundle with cosign. Downloads are https-only, size-capped and
# time-limited, and replace the cached copy only when both files arrived.
# Callers run this best effort (`|| true`) so it never breaks apt/dnf updates.
#
# Test hooks (environment): USG_PLAT_VERIFY_CONF, USG_PLAT_VERIFY_STATE,
# USG_PLAT_VERIFY_PATH (see verify-pkg).
#
# COMPLIANCE MAPPING:
# - NIST 800-53: SI-7(15) (Code Authentication) - supplies the signed sums the
#   gate verifies
# - NIST 800-53: SC-5 (Denial-of-Service Protection) - bounded cache (20
#   releases), 1 MiB per file, 30 s per fetch
set -u

PATH=${USG_PLAT_VERIFY_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}
export PATH
umask 022

CONF=${USG_PLAT_VERIFY_CONF:-/etc/usg-plat-verify/verify.conf}
STATE=${USG_PLAT_VERIFY_STATE:-/var/lib/usg-plat-verify}
KEEP=20
MAX_BYTES=1048576

die() { echo "usg-plat-verify fetch-sums: $1" >&2; exit "${2:-1}"; }

[ -f "$CONF" ] && [ -r "$CONF" ] || die "configuration $CONF missing" 2
NAMES='' REPO_BASE=''
# shellcheck source=deploy/verify/etc/verify.conf
. "$CONF" || die "configuration $CONF does not parse" 2
case $REPO_BASE in
    https://* | file:///*) ;;
    *) die "REPO_BASE must be https:// or file:///" 2 ;;
esac
case $REPO_BASE in *[!A-Za-z0-9:/._~-]*) die "REPO_BASE has unexpected characters" 2 ;; *) ;; esac
REPO_BASE=${REPO_BASE%/}

# Normalise each argument to a tag; drop anything malformed.
to_tag() {
    t=${1#v}
    t=${t%%-*}
    printf '%s\n' "$t" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' || return 1
    printf 'v%s\n' "$t"
}

fetch() { # url dest
    case $1 in
        file://*)
            src=${1#file://}
            [ -f "$src" ] || return 1
            sz=$(wc -c <"$src") || return 1
            [ "$sz" -le $MAX_BYTES ] || return 1
            cp -- "$src" "$2"
            ;;
        *)
            if command -v curl >/dev/null 2>&1; then
                curl -fsS --proto '=https' --tlsv1.2 --max-time 30 \
                    --max-filesize $MAX_BYTES -o "$2" -- "$1"
            elif command -v wget >/dev/null 2>&1; then
                wget -q --https-only --timeout=30 -O "$2" -- "$1" || return 1
                sz=$(wc -c <"$2") || return 1
                [ "$sz" -le $MAX_BYTES ]
            else
                return 1
            fi
            ;;
    esac
}

# one TAG-or-VERSION: fetch into a private part directory, then move into place.
one() {
    tag=$(to_tag "$1") || return 0
    dest="$STATE/releases/$tag"
    part="$STATE/releases/.$tag.part.$$"
    mkdir -- "$part" 2>/dev/null || return 1
    ok=1
    if fetch "$REPO_BASE/releases/$tag/SHA256SUMS" "$part/SHA256SUMS" &&
        fetch "$REPO_BASE/releases/$tag/SHA256SUMS.sigstore.json" "$part/SHA256SUMS.sigstore.json"; then
        if mkdir -p -- "$dest" &&
            mv -f -- "$part/SHA256SUMS.sigstore.json" "$dest/SHA256SUMS.sigstore.json" &&
            mv -f -- "$part/SHA256SUMS" "$dest/SHA256SUMS"; then
            ok=0
        fi
    else
        echo "usg-plat-verify fetch-sums: could not fetch sums for $tag" >&2
    fi
    rm -f -- "$part/SHA256SUMS" "$part/SHA256SUMS.sigstore.json"
    rmdir -- "$part" 2>/dev/null
    return $ok
}

# The arguments, or the apt Installed/Candidate versions of NAMES, one per line.
versions() {
    if [ $# -gt 0 ]; then
        printf '%s\n' "$@"
    elif command -v apt-cache >/dev/null 2>&1; then
        for n in $NAMES; do
            apt-cache policy "$n" 2>/dev/null
        done | sed -n -e 's/^[[:space:]]*Installed:[[:space:]]*\([0-9][^[:space:]]*\)$/\1/p' \
            -e 's/^[[:space:]]*Candidate:[[:space:]]*\([0-9][^[:space:]]*\)$/\1/p' | sort -u
    fi
}

mkdir -p -- "$STATE/releases" 2>/dev/null || die "cannot create $STATE/releases"
rc=0
list=$(versions "$@")
while IFS= read -r a; do
    [ -n "$a" ] || continue
    one "$a" || rc=1
done <<EOF
$list
EOF

# Retention: newest $KEEP release directories by mtime. Only names matching
# the tag grammar are ever touched, and only by file name (no recursive rm).
n=0
for old in $(cd "$STATE/releases" 2>/dev/null && ls -1t); do
    printf '%s\n' "$old" | grep -Eqx 'v[0-9]+\.[0-9]+\.[0-9]+' || continue
    n=$((n + 1))
    [ $n -gt $KEEP ] || continue
    rm -f -- "$STATE/releases/$old/SHA256SUMS" "$STATE/releases/$old/SHA256SUMS.sigstore.json"
    rmdir -- "$STATE/releases/$old" 2>/dev/null
done
exit $rc
