#!/bin/sh
# usg-plat-verify: operator front end of the usg-plat install-time gate.
#
# Usage: usg-plat-verify selftest       full self-test (cosign, trust root, pin)
#        usg-plat-verify status         configuration, cosign, trust root, last refusal
#        usg-plat-verify verify FILE    run the gate on a .deb or .rpm by hand
# Exit:  selftest/verify as libexec/selftest and verify-pkg (0 ok, 1 refused
#        or failed, 2 usage/config); status 0.
#
# `verify FILE` reads name/version/arch from the package header, hashes the
# file and calls verify-pkg; SHA256SUMS is taken from FILE's directory when a
# SHA256SUMS is there, otherwise from the cache. Nothing is installed.
#
# Test hooks (environment): USG_PLAT_VERIFY_CONF, USG_PLAT_VERIFY_STATE,
# USG_PLAT_VERIFY_TRUSTED_ROOT, USG_PLAT_VERIFY_LIBEXEC, USG_PLAT_VERIFY_PATH,
# USG_PLAT_VERIFY_TEST_TOP; honoured only with USG_PLAT_VERIFY_TEST=1.
#
# COMPLIANCE MAPPING:
# - NIST 800-53: SI-7(15) (Code Authentication), CM-14 (Signed Components),
#   SR-11 (Component Authenticity), SI-6 (Security Function Verification)
set -u

# >>> common: test hooks and root_only (identical in every script; unit.sh checks)
# Test hooks (the USG_PLAT_VERIFY_* overrides named in the header, and TMPDIR)
# are honoured only when USG_PLAT_VERIFY_TEST=1, which only the test suites
# set. Otherwise they are unset, so children inherit a clean environment, and
# logged once to authpriv. When it is honoured, every invocation logs
# "test mode enabled" at authpriv.warning and on stderr, so a production host
# left in test mode is visible. USG_PLAT_VERIFY_SUMS_DIR is not a hook: the front
# ends set it for local installs and verify-pkg still verifies what it names.
#
# COMPLIANCE MAPPING:
# - NIST 800-53: CM-6 (Configuration Settings), SI-7(15) (Code Authentication)
#   - the decision depends only on root-owned, root-only-writable files
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
uv_test=0
if [ "${USG_PLAT_VERIFY_TEST:-}" = 1 ]; then
    uv_test=1
    uv_msg="test mode enabled: overrides honoured (USG_PLAT_VERIFY_TEST=1)"
    printf 'usg-plat-verify: %s\n' "$uv_msg" >&2
    PATH=${USG_PLAT_VERIFY_PATH:-$PATH} logger -t usg-plat-verify -p authpriv.warning -- "$uv_msg" 2>/dev/null || :
else
    uv_ign=$(env | sed -n 's/^\(USG_PLAT_VERIFY_[A-Z_]*\)=.*/\1/p' |
        grep -v -x -e USG_PLAT_VERIFY_SUMS_DIR -e USG_PLAT_VERIFY_TEST | sort -u | tr '\n' ' ')
    [ -n "${TMPDIR+x}" ] && uv_ign="${uv_ign}TMPDIR "
    for uv_v in $uv_ign; do
        unset "$uv_v"
    done
    unset USG_PLAT_VERIFY_TEST
    if [ -n "$uv_ign" ]; then
        uv_msg="ignoring test-only environment (USG_PLAT_VERIFY_TEST is not 1): $uv_ign"
        printf 'usg-plat-verify: %s\n' "$uv_msg" >&2
        logger -t usg-plat-verify -p authpriv.warning -- "$uv_msg" 2>/dev/null || :
    fi
fi

# root_only PATH: PATH and every ancestor directory exist, are not symlinks,
# are owned by uid 0 and are neither group- nor other-writable (POSIX ACLs
# are not inspected). A sticky world-writable directory such as /tmp fails: its other users
# can still rename or replace entries they own. In test mode the invoking uid
# also counts as an owner and the walk stops at USG_PLAT_VERIFY_TEST_TOP.
root_only() {
    case $1 in /*) ;; *) return 1 ;; esac
    case $1 in */./* | */../* | */. | */.. | *//*) return 1 ;; *) ;; esac
    ro_p=$1
    while :; do
        if [ $uv_test -eq 1 ] && [ -n "${USG_PLAT_VERIFY_TEST_TOP:-}" ] &&
            [ "$ro_p" = "$USG_PLAT_VERIFY_TEST_TOP" ]; then
            return 0
        fi
        [ -e "$ro_p" ] && [ ! -L "$ro_p" ] || return 1
        ro_l=$(LC_ALL=C stat -c '%A %u' -- "$ro_p" 2>/dev/null) || return 1
        ro_m=${ro_l%% *} ro_u=${ro_l#* }
        case $ro_m in
            ?????w* | ????????w*) return 1 ;;
            ??????????*) ;;
            *) return 1 ;;
        esac
        if [ "$ro_u" != 0 ]; then
            [ $uv_test -eq 1 ] && [ "$ro_u" = "$(id -u)" ] || return 1
        fi
        [ "$ro_p" = / ] && return 0
        ro_p=${ro_p%/*}
        [ -n "$ro_p" ] || ro_p=/
    done
}
# <<< common

PATH=${USG_PLAT_VERIFY_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}
export PATH

CONF=${USG_PLAT_VERIFY_CONF:-/etc/usg-plat-verify/verify.conf}
STATE=${USG_PLAT_VERIFY_STATE:-/var/lib/usg-plat-verify}
TRUSTED_ROOT=${USG_PLAT_VERIFY_TRUSTED_ROOT:-/usr/share/usg-plat-verify/trusted_root.json}
LIBEXEC=${USG_PLAT_VERIFY_LIBEXEC:-/usr/libexec/usg-plat-verify}

usage() {
    echo "usage: usg-plat-verify selftest | status | verify FILE" >&2
    exit 2
}

[ $# -ge 1 ] || usage
cmd=$1
shift
case $cmd in
    selftest)
        [ $# -eq 0 ] || usage
        exec "$LIBEXEC/selftest" --full
        ;;
    status)
        [ $# -eq 0 ] || usage
        echo "config:       $CONF"
        COSIGN='' NAMES='' REPO_BASE=''
        if [ -r "$CONF" ] && ! root_only "$CONF"; then
            echo "WARNING:      $CONF is not root-owned or is group/other-writable; not read (the gate refuses)"
        elif [ -r "$CONF" ]; then
            # shellcheck source=deploy/verify/etc/verify.conf
            . "$CONF"
        fi
        echo "names:        ${NAMES:-?}"
        echo "repo base:    ${REPO_BASE:-?}"
        if [ -x "${COSIGN:-}" ]; then
            v=$("$COSIGN" version 2>/dev/null | sed -n 's/^GitVersion:[[:space:]]*//p' | head -n 1)
            h=$(sha256sum -- "$COSIGN" 2>/dev/null)
            echo "cosign:       $COSIGN ${v:-version unknown} sha256 ${h%% *}"
        else
            echo "cosign:       MISSING at ${COSIGN:-?} (every usg-plat install is refused)"
        fi
        if [ -f "$TRUSTED_ROOT" ]; then
            h=$(sha256sum -- "$TRUSTED_ROOT" 2>/dev/null)
            echo "trusted root: $TRUSTED_ROOT sha256 ${h%% *}"
        else
            echo "trusted root: MISSING at $TRUSTED_ROOT"
        fi
        rel=''
        for d in "$STATE"/releases/v*; do
            [ -d "$d" ] && rel="$rel ${d##*/}"
        done
        echo "cached sums: ${rel:- none}"
        if [ -f "$STATE/last-refusal" ]; then
            echo "last refusal: $(head -c 512 "$STATE/last-refusal")"
        else
            echo "last refusal: none"
        fi
        echo "refusals:     $(cat "$STATE/refusals_total" 2>/dev/null || echo 0)"
        exit 0
        ;;
    verify)
        [ $# -eq 1 ] || usage
        f=$1
        case $f in /*) ;; *) f="$(pwd)/$f" ;; esac
        [ -f "$f" ] && [ ! -L "$f" ] || { echo "usg-plat-verify: $f is not a regular file" >&2; exit 2; }
        case $f in
            *.deb)
                command -v dpkg-deb >/dev/null 2>&1 || { echo "usg-plat-verify: dpkg-deb not found" >&2; exit 2; }
                fields=$(dpkg-deb -f "$f" Package Version Architecture 2>/dev/null) ||
                    { echo "usg-plat-verify: cannot read $f" >&2; exit 1; }
                n=$(printf '%s\n' "$fields" | sed -n 's/^Package: //p')
                v=$(printf '%s\n' "$fields" | sed -n 's/^Version: //p')
                a=$(printf '%s\n' "$fields" | sed -n 's/^Architecture: //p')
                ;;
            *.rpm)
                command -v rpm >/dev/null 2>&1 || { echo "usg-plat-verify: rpm not found" >&2; exit 2; }
                n=$(rpm -qp --nosignature --qf '%{NAME}' -- "$f" 2>/dev/null)
                v=$(rpm -qp --nosignature --qf '%{VERSION}-%{RELEASE}' -- "$f" 2>/dev/null)
                a=$(rpm -qp --nosignature --qf '%{ARCH}' -- "$f" 2>/dev/null)
                ;;
            *) echo "usg-plat-verify: $f is not a .deb or .rpm" >&2; exit 2 ;;
        esac
        h=$(sha256sum -- "$f" 2>/dev/null) || { echo "usg-plat-verify: cannot hash $f" >&2; exit 1; }
        h=${h%% *}
        d=${f%/*}
        [ -n "$d" ] || d=/
        if [ -f "$d/SHA256SUMS" ]; then
            USG_PLAT_VERIFY_SUMS_DIR=$d exec "$LIBEXEC/verify-pkg" \
                --name "$n" --version "$v" --arch "$a" --sha256 "$h"
        fi
        exec "$LIBEXEC/verify-pkg" --name "$n" --version "$v" --arch "$a" --sha256 "$h"
        ;;
    *) usage ;;
esac
