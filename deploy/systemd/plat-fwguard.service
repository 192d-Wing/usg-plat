# NIST 800-53: SC-7, SC-24 - disable forwarding when the host forward policy
# (table inet plat) is missing or differs from what plat-tun-setup.sh loaded.
# Triggered by plat-fwguard.timer; the nftables.service drop-in runs the same
# script directly after nftables starts, reloads or stops.
# NIST 800-53: AC-6, CM-7 - runs as root (nft netlink, root-owned
# /proc/sys/net files) with only CAP_NET_ADMIN in its bounding set.
[Unit]
Description=usg-plat forward policy guard (fail closed)
After=nftables.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/plat/plat-fwguard.sh
# nft(8) needs CAP_NET_ADMIN on its netlink socket. Writing
# /proc/sys/net/ipv{4,6}/... needs uid 0 (file owner, mode 0644; no
# CAP_DAC_OVERRIDE) and, for net sysctls, CAP_NET_ADMIN in the network
# namespace. Nothing else.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# ProtectKernelTunables= must stay off: it makes /proc/sys read-only.
ReadWritePaths=/proc/sys/net
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
