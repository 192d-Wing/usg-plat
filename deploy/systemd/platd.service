# NIST 800-53: AC-6 (Least Privilege), CM-7 (Least Functionality), SC-39 (Process Isolation)
# NIST 800-53: AU-8 - start only after the clock is synchronised: ordered
# after time-sync.target, which is held back by the time daemon's wait unit.
# Enable the one matching your daemon (see README):
#   chrony:           systemctl enable chrony-wait.service
#   systemd-timesyncd: systemctl enable systemd-time-wait-sync.service
# (systemd-time-wait-sync can wait forever under chrony, so it is not pulled
# in here.)
[Unit]
Description=usg-plat 464XLAT PLAT / NAT64 translator
Wants=network-online.target time-sync.target plat-fwguard.timer
After=network-online.target time-sync.target
# CP-10, SC-24: stop restarting after 5 failed starts within 60 s instead of
# looping forever (RestartSec=2s alone never hits the default limit).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Runs as root ('+' prefix) to create the persistent TUN owned by plat:plat.
# It also creates /var/log/plat as plat:plat-log 2750 (tmpfiles.d).
ExecStartPre=+/usr/libexec/plat/plat-tun-setup.sh /etc/plat/platd.toml
ExecStart=/usr/bin/platd run --config /etc/plat/platd.toml
Restart=on-failure
RestartSec=2s
User=plat
Group=plat
# No capabilities: the TUN device is owned by plat:plat, so attaching its
# queues needs no privilege (AC-6).
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=yes
UMask=0027
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
RemoveIPC=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Allow-list first, then remove privileged and resource-control calls;
# sched_setaffinity (in @resources) is re-added for dataplane.pin_cpus.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=sched_setaffinity
SystemCallErrorNumber=EPERM
# SC-5 backstop against runaway memory or threads (tables and queues are
# bounded by the config; size MemoryMax to about
# nat64.max_sessions x 800 B + audit.queue_capacity x 64 B + 256 MiB headroom;
# measured on aarch64: ~780 B/session, 3.05 GB at 3.91 M sessions with a
# 1 Mi-record queue). 8G covers the default 4 M sessions; on a host with
# 8 GiB of RAM or less it is no backstop, so lower it there.
MemoryMax=8G
TasksMax=1024
# Audit logs (AU-9): writable by plat only; readable by group plat-log
# (log shippers, verify-log operators), never through the plat group.
# /var/log/plat is plat:plat-log 2750 from tmpfiles.d (plat.tmpfiles.conf,
# applied by plat-tun-setup.sh), not LogsDirectory=: systemd re-applies
# LogsDirectory= ownership and mode after ExecStartPre= and would drop the
# plat-log group and setgid (L13).
# No "-" prefix on purpose (fail loud): systemd sets up this mount before
# ExecStartPre= runs, so the directory must already exist, or the start fails
# with 226/NAMESPACE. Install creates it with
#   systemd-tmpfiles --create /usr/lib/tmpfiles.d/plat.conf
# (after the plat user and plat-log group exist, see README); at boot
# systemd-tmpfiles-setup.service recreates it (L5).
ReadWritePaths=/var/log/plat
# Cluster route hooks (cluster.ha.hooks.*) run as children of platd, so they
# inherit this sandbox. The shipped FRR hooks call vtysh, which connects to
# the FRR daemons' AF_UNIX sockets in /run/frr (already in
# RestrictAddressFamilies); connect() needs no write access to the
# file system, but the path must stay visible, hence "-" (optional) RW
# here. vtysh also needs the plat user in the frrvty group (README:
# usermod -aG frrvty plat); it is not set here so the unit starts on hosts
# without FRR. No capability is added: hooks run unprivileged as plat.
ReadWritePaths=-/run/frr
# Optional CRL disk cache (tls.revocation.cache_dir =
# "/var/lib/plat/revocation"): systemd creates it owned by plat:plat with
# mode 0700, as check_cache_dir requires, and makes it writable under
# ProtectSystem=strict (IA-5(2)(b)(2), SC-28). Harmless when unused.
# Cluster HA (cluster.ha.state_dir = "/var/lib/plat/cluster"): epoch and
# vote state (cluster.state, fsynced), the operator socket ctl.sock (0600,
# `platd cluster ...`) and announce.d/ for routing daemons; 0700 plat:plat
# as platd checks at start (SC-24, AC-6). Harmless without HA.
StateDirectory=plat/revocation plat/cluster
StateDirectoryMode=0700
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
